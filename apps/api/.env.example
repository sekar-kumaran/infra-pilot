APP_NAME=InfraPilot
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/infrapilot
REDIS_URL=
RABBITMQ_URL=
CORS_ALLOWED_ORIGINS=*

# Auth
AUTH_SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ALGORITHM=HS256

# Integrations & Celery
INTEGRATION_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
