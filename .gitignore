# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (explicitly scoped so apps/web/src/lib/ is NEVER ignored!)
.venv/
venv/
env/
/lib/
/lib64/
!apps/web/src/lib/
!apps/web/src/lib/**
!**/src/lib/
!**/src/lib/**

# Node / Next.js
node_modules/
.next/
out/

# Databases & logs
*.db
*.db-shm
*.db-wal
*.log
